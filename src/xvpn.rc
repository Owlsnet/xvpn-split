#include <winres.h>
#include "resource.h"

IDI_APP ICON "..\\assets\\xvpn.ico"

// engine scripts, unpacked to %LOCALAPPDATA%\xvpn at start
IDR_APP_CHOOSER  RCDATA "..\\engine\\app-chooser.ps1"
IDR_APP_BYPASS   RCDATA "..\\engine\\app-bypass.ps1"
IDR_SPLIT_TUNNEL RCDATA "..\\engine\\split-tunnel.ps1"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,3,0
 PRODUCTVERSION  1,0,3,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "xvpn - split tunneling for full-tunnel VPNs"
            VALUE "FileVersion",      "1.0.3"
            VALUE "InternalName",     "xvpn-ui"
            VALUE "OriginalFilename", "xvpn-ui.exe"
            VALUE "ProductName",      "xvpn"
            VALUE "ProductVersion",   "1.0.3"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
